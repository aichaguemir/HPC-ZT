# Database Configuration
DATABASE_URL=postgresql+asyncpg://hpcuser:YOUR_DB_PASSWORD@hpc-postgres:5432/hpc_portal

# Keycloak Configuration
KEYCLOAK_URL=https://host.docker.internal:8443
KEYCLOAK_VERIFY_SSL=False
KEYCLOAK_REALM=HPC-Project
KEYCLOAK_CLIENT_ID=hpc-backend

# SSH & Remote Execution
SSH_HOST=YOUR_LSF_MASTER_HOSTNAME
SSH_USER=your_ssh_username
SSH_PASSWORD=

# Audit Trail Configuration
AUDIT_CHAIN_SECRET=
AUDIT_ANCHOR_INTERVAL=10
AUDIT_ANCHOR_FILE=/path/to/audit_anchors/audit_anchors.jsonl

# LSF & File Paths
LSF_PATH=/shared/ibm/platform_lsf/9.1/linux2.6-glibc2.3-x86_64/bin
REMOTE_JOB_DIR=/path/to/remote/jobs
